# Application configuration
app:
  # Application name
  name: ${name}
  # Version
  version: 1.0.0
  # Copyright year
  copyrightYear: 2025
  # File path, for example D:/app/uploadPath on Windows or /home/app/uploadPath on Linux
  profile: ${profile}
  # Enable IP address lookup
  addressEnabled: false
  # CAPTCHA type: math for arithmetic or char for character validation
  captchaType: math

# Server configuration
server:
  # HTTP server port, defaults to 8080
  port: 8080
  servlet:
    # Application context path
    context-path: /
  tomcat:
    # Tomcat URI encoding
    uri-encoding: UTF-8
    # Maximum request queue length when all connections are in use, defaults to 100
    accept-count: 1000
    threads:
      # Maximum number of Tomcat worker threads, defaults to 200
      max: 800
      # Number of Tomcat worker threads initialized at startup, defaults to 10
      min-spare: 100

# Logging configuration
logging:
  level:
    com.demo: debug
    org.springframework: warn

# User configuration
user:
  password:
    # Maximum number of failed password attempts
    maxRetryCount: 5
    # Password lock duration in minutes, defaults to 10
    lockTime: 10

# Spring configuration
spring:
  # Message resources
  messages:
    # Internationalization resource bundle path
    basename: i18n/messages
  profiles:
    active: druid
  # File upload
  servlet:
    multipart:
      # Maximum size of a single file
      max-file-size: 10MB
      # Maximum total upload size
      max-request-size: 20MB
  # Development tools
  devtools:
    restart:
      # Enable automatic restart
      enabled: true
  data:
    # Redis configuration
    redis:
      # Host
      host: localhost
      # Port, defaults to 6379
      port: 6379
      # Database index
      database: 0
      # Password
      password:
      # Connection timeout
      timeout: 10s
      lettuce:
        pool:
          # Minimum number of idle connections
          min-idle: 0
          # Maximum number of idle connections
          max-idle: 8
          # Maximum number of active connections
          max-active: 8
          # Maximum blocking wait time; use a negative value for no limit
          max-wait: -1ms

# Token configuration
token:
  # Custom token header
  header: Authorization
  # Token secret
  secret: abcdefghijklmnopqrstuvwxyz
  # Token validity period in minutes, defaults to 60
  expireTime: 60

# MyBatis configuration
mybatis-plus:
  # Package pattern for type aliases
  typeAliasesPackage: com.demo.**.domain
  # Locations of Mapper XML files
  mapperLocations: classpath*:mapper/**/*Mapper.xml
  # Global MyBatis configuration file
  configLocation: classpath:mybatis/mybatis-config.xml

# PageHelper pagination plugin
pagehelper:
  helperDialect: mysql
  supportMethodsArguments: true
  params: count=countSql

# Springdoc configuration
springdoc:
  api-docs:
    path: /v3/api-docs
  swagger-ui:
    enabled: true
    path: /swagger-ui.html
    tags-sorter: alpha
  group-configs:
    - group: 'default'
      display-name: 'Business Module'
      paths-to-match: '/**'
      packages-to-scan: com.demo.business.controller

# XSS protection
xss:
  # Enable filtering
  enabled: true
  # Excluded paths, separated by commas
  excludes: /system/notice
  # Paths to filter
  urlPatterns: /system/*,/monitor/*,/tool/*
